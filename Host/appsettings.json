{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "File": {
      "FileName": "Logs/{0}/{1:yyyy}-{1:MM}-{1:dd}.log",
      // 日志文件完整路径或文件名，推荐 .log 作为拓展名
      //追加到已存在日志文件或覆盖它们
      "Append": true,
      //最低日志记录级别
      "MinimumLevel": "Information",
      //日期格式
      "DateFormat": "yyyy-MM-dd HH:mm:ss.fffffff zzz dddd",
      //显示跟踪/请求 Id
      "WithTraceId": true,
      //显示堆栈框架（程序集和方法签名）
      "WithStackFrame": true,
      //是否启用日志上下文
      "IncludeScopes": true,
      //是否使用 UTC 时间戳，默认 false
      "UseUtcTimestamp": false,
      //控制每一个日志文件最大存储大小，单位是 B，也就是 1024 才等于 1KB，默认无限制，如果指定了该值，那么日志文件大小超出了该配置就会创建新的日志文件，新创建的日志文件命名规则：文件名+[递增序号].log
      "FileSizeLimitBytes": 0,
      //控制最大创建的日志文件数量，默认无限制，配合 FileSizeLimitBytes 使用，如果指定了该值，那么超出该值将从最初日志文件中从头写入覆盖
      "MaxRollingFiles": 0
    },
    "Monitor": {
      //是否启用全局拦截，默认 `false`
      "GlobalEnabled": false,
      //是否指定拦截特定方法，当 GlobalEnabled: false 有效
      "IncludeOfMethods": [],
      //是否指定排除特定方法，当 GlobalEnabled: true 有效
      "ExcludeOfMethods": [],
      //配置监听日志输出级别，默认 Information
      "LogLevel": "Information",
      //配置 Oops.Oh 和 Oops.Bah 业务日志输出级别，默认 Information
      "BahLogLevel": "Information",
      //配置是否包含返回值，默认 `true`，Furion 4.3.9+ 有效
      "WithReturnValue": true,
      //配置返回值字符串阈值，默认 0，全量输出，Furion 4.3.9+ 有效
      "ReturnValueThreshold": 0,
      //配置 LoggingMonitor None,OnlyJson,All Json 输出行为，默认 None，Furion 4.5.2+ 有效
      "JsonBehavior": "All",
      //配置 LoggingMonitor Json 格式化行为，默认 false，Furion 4.8.2+ 有效
      "JsonIndented": true,
      //配置 LoggingMonitor 序列化属性命名规则，默认 CamelCase，Furion 4.8.6.12+ 有效
      "ContractResolver": "CamelCase",
      //忽略的属性名称
      "IgnorePropertyNames": [],
      //忽略的属性类型
      "IgnorePropertyTypes": [
        "byte",
        "stream"
      ],
      "FromGlobalFilter": true,
      "IsMvcFilterRegister": false,
      "LongTypeConverter": true
      // 配置被监视方法更多信息，Furion 4.3.9+ 有效
      //      "MethodsSettings": [
      //        {
      //          "FullName": "Furion.Application.TestLoggerServices.MethodName",
      //          // 方法完全限定名
      //          "WithReturnValue": true,
      //          // 配置是否包含返回值，默认 `true`，Furion 4.3.9+ 有效
      //          "ReturnValueThreshold": 0,
      //          // 配置返回值字符串阈值，默认 0，全量输出，Furion 4.3.9+ 有效
      //          "JsonIndented": false,
      //          // 配置 LoggingMonitor Json 格式化行为，默认 false，Furion 4.8.2+ 有效
      //          "JsonBehavior": "None",
      //          // 配置 LoggingMonitor Json 输出行为，默认 None，Furion 4.5.2+ 有效
      //          "ContractResolver": "CamelCase"
      //          // 配置 LoggingMonitor 序列化属性命名规则，默认 CamelCase，Furion 4.8.6.12+ 有效
      //        }
      //      ]
    }
  },
  "AllowedHosts": "*",
  //JSON Schema 是用于验证 JSON 数据结构的强大工具
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  //框架扫描.Json自定义配置项
  //"ConfigurationScanDirectories": ["目录1名称", "目录1名称/子目录名称"]
  //排除特定配置文件,支持完整的通配符
  //"IgnoreConfigurationFiles": ["runtime.json","seed_*.json"]

  //1:AppSettings设置项
  "AppSettings": {
    //判断是否启用规范化文档
    "InjectSpecificationDocument": true,
    //是否启用引用程序集扫描(组件开发，需要开启，并配置组件的程序集)---开启模块化功能
    "EnabledReferenceAssemblyScan": true,
    //配置支持的包(组件名称)-通过 NuGet 方式安装模块
    "SupportPackageNamePrefixs": [
      "*.Component"
    ],
    //通过动态加载 .dll 方式安装模块,外部程序集 扫描 dll 文件，如果是单文件发布，需拷贝放在根目录下(组件开发，需要开启，并配置组件的程序集)
    "ExternalAssemblies": [
      //"Core.Furion.Component.dll",
      //"SqlSugarCoreExtra.Furion.Component.dll",
      //"Jcon.Refit.Furion.Component.dll"
    ],
    //排除扫描的程序集
    "ExcludeAssemblies": [],
    //是否输出原始 Sql 执行日志（ADO.NET）
    "OutputOriginalSqlExecuteLog": false,
    //【部署】二级虚拟目录
    "VirtualPath": "",
    //JSON 文件扫描配置(修复 docker 中挂载大文件数据卷导致启动缓慢的问题)
    "JsonFileScanner": {
      "Optional": true,
      //是否可选
      "ReloadOnChange": true
      //是否改变的时候重载
    },
    //是否禁用 AppStartup 自动扫描
    "DisableAppStartupScan": false
  },
  //2:本地化配置项
  "LocalizationSettings": {
    //"AssemblyName": "Furion.Web.Entry",
    //"ResourcesPath": "Resources",
    //"LanguageFilePrefix": "Lang",
    //配置支持的语言列表
    "SupportedCultures": [
      "zh-CN",
      "en-US"
    ],
    //配置默认语言，如果不配置，取 SupportedCultures的第一项
    "DefaultCulture": "zh-CN",
    //设置 DateTime 格式化标准语言，不设置则自动根据当前语言
    "DateTimeFormatCulture": "zh-CN"
  },
  //3:配置 MVC 控制器支持规范化处理
  "UnifyResultSettings": {
    "SupportMvcController": true
    //    "Return200StatusCodes": [
    //      401,
    //      403
    //    ],
    //    "AdaptStatusCodes": null,
    //    "SingleValidationErrorDisplay": false
  },
  //4:跨域设置
  "CorsAccessorSettings": {
    //    //策略名称
    //    "PolicyName": "",
    //    //是否允许跨域请求中的凭据
    //    "AllowCredentials": true,
    //    //允许来源域名，没有配置则允许所有来源
    //    "WithOrigins": ["",""],
    //    //请求表头，没有配置则允许所有表头
    //    "WithHeaders": ["",""],
    //    //设置跨域允许请求谓词，没有配置则允许所有
    //    "WithMethods": ["",""],
    //设置客户端可获取的响应标头
    "WithExposedHeaders": [
      "access-token",
      "x-access-token",
      "environment",
      "Content-Disposition",
      "Access-Control-Expose-Headersx-access-token"
    ],
    //设置预检过期时间
    //"SetPreflightMaxAge": 1000,
    //修正前端无法获取 Token 问题
    "FixedClientToken": true,
    //启用 SignalR 跨域支持
    "SignalRSupport": true
  },
  //5:动态Api配置项
  "DynamicApiControllerSettings": {
    //默认路由前缀，string，默认 api
    "DefaultRoutePrefix": "api",
    //默认请求谓词，string，默认：POST
    "DefaultHttpMethod": "POST",
    //默认模块名称（区域），可用作接口版本，string，默认 null
    //"DefaultModule": null,
    //是否采用小写路由，bool 类型，默认 true
    "LowercaseRoute": true,
    //启用小驼峰命名（首字母小写），默认 false
    "AsLowerCamelCase": true,
    //是否保留动作谓词，bool，默认：false
    "KeepVerb": false,
    //是否保留默认名称，bool，默认：false
    "KeepName": true,
    //骆驼（驼峰）命名分隔符，string，默认：-
    "CamelCaseSeparator": "",
    //版本分隔符，string，默认：v，Furion 4.9.1.14 之前是 @
    "VersionSeparator": "v",
    //版本号是否在前面，bool，默认 true，Furion 4.9.1.14+ 支持
    "VersionInFront": true,
    //GET/HEAD 请求将 类类型参数转查询参数，bool，默认 false
    "ModelToQuery": true,
    //是否支持 Mvc Controller 动态配置，bool，默认 false
    "SupportedMvcController": false,
    //路由参数采用 [FromQuery] 化，默认 false（[FromRoute]方式）
    "UrlParameterization": false,
    //配置是否强制添加 DefaultRoutePrefix，当控制器自定义了[Route] 有效，默认 false，仅限 v3.4.1+版本有效
    "ForceWithRoutePrefix": false,
    //默认去除控制器名称前后缀列表名，string[]
    "AbandonControllerAffixes": [
      "AppServices",
      "AppService",
      "ApiController",
      "Controller",
      "Services",
      "Service"
    ],
    //默认去除动作方法名称前后缀列表名，string[]，默认：Async
    "AbandonActionAffixes": [
      "Async"
    ]
    //复写默认方法名转 [HttpMethod] 规则，string[][] 二维数组类型
    //"VerbToHttpMethods":[],
    //配置默认区域，默认 null
    //"DefaultArea": null,
    //默认基元参数绑定方式
    //"DefaultBindingInfo": "route"
  },
  //6:Swagger接口配置
  "SpecificationDocumentSettings": {
    "DocumentTitle": "接口文档",
    //Swagger接口开启授权
    "EnableAuthorized": true,
    "RoutePrefix": "swagger",
    //List：列表式（展开子类），默认值,Full：完全展开,None：列表式（不展开)
    "DocExpansionState": "None",
    "EnableAllGroups": false,
    //所有(默认)接口的分组
    "DefaultGroupName": "默认分组",
    //枚举转数字
    "EnumToNumber": true,
    //是否默认深色主题
    "DarkMode": false,
    //是否采用最新版本（优先级小于FormatAsV2）
    "LatestVersion": true,
    //    //格式化为V2版本
    //    "FormatAsV2": true,
    //    //是否自动加载 Xml 注释文件
    //    "EnableXmlComments": true,
    //    //XML 描述文件
    //    "XmlComments": [],
    //分组信息
    "GroupOpenApiInfos": [
      {
        "Group": "Main",
        "Order": 100000,
        "Title": "主分组",
        "Visible": true,
        "RouteTemplate": null,
        //隐藏分组的 Visible 配置
        "Description": "这里是主分组",
        "Version": "1.0.0",
        "TermsOfService": null,
        "Contact": {
          "Name": "开发人员1",
          "Url": "https://www.baidu.com/",
          "Email": "17750777568@163.com",
          "Extensions": {}
        },
        "License": {
          "Name": "MIT",
          "Url": "https://gitee.com/dotnetchina/Furion/blob/alpha/LICENSE"
        },
        "Extensions": {}
      }
    ],
    //授权控制
    "SecurityDefinitions": [
      {
        "Id": "Bearer",
        //ApiKey=0,Http=1,OAuth2=2,OpenIdConnect=3
        "Type": 1,
        "Name": "Authorization",
        "Description": "JWT Authorization header using the Bearer scheme",
        "BearerFormat": "JWT",
        "Scheme": "bearer",
        //Query=0，Header=1，Cookie=2
        "In": 1,
        "Requirement": {
          "Scheme": {
            "Reference": {
              "Id": "Bearer",
              "Type": 6
            },
            "Accesses": []
          }
        }
      }

      //      {
      //        "Id": "Bearer",
      //        //ApiKey=0,Http=1,OAuth2=2,OpenIdConnect=3
      //        "Type": 1,
      //        "Description": "JWT Authorization header using the Bearer scheme",
      //        "Name": "Authorization",
      //        "In": "Header",
      //        "Scheme": "bearer",
      //        "BearerFormat": "JWT",
      //        "Flows": null,
      //        "OpenIdConnectUrl": null,
      //        "Extensions": {},
      //        "UnresolvedReference": false,
      //        "Reference": {},
      //        "Requirement": {
      //          //安全Schema
      //          "Scheme": {
      //            //ApiKey=0,Http=1,OAuth2=2,OpenIdConnect=3
      //            "Type": 0,
      //            "Description": "Scheme描述",
      //            "Name": "Scheme名称",
      //            //Query=0，Header=1，Cookie=2
      //            "In": 1,
      //            "Scheme": "",
      //            "BearerFormat": "",
      //            "Flows": {
      //              "Implicit": {},
      //              "Password": {},
      //              "ClientCredentials": {},
      //              "AuthorizationCode": {}
      //            },
      //            "OpenIdConnectUrl": null,
      //            "Extensions": {},
      //            "UnresolvedReference": false,
      //            "Reference": {
      //              "IsFragrament": false,
      //              "ExternalResource": null,
      //              "Type": 6,
      //              "Id": "Bearer",
      //              "IsExternal": false,
      //              "IsLocal": true,
      //              "HostDocument": null,
      //              "ReferenceV3": "Bearer",
      //              "ReferenceV2": "Bearer"
      //            }
      //          },
      //          "Accesses": []
      //          //权限
      //        }
      //      }
    ],
    "Servers": [],
    //是否隐藏Server下拉列表
    "HideServers": true,
    //"RouteTemplate": "swagger/{documentName}/swagger.json",
    "PackagesGroups": [],
    "EnableEnumSchemaFilter": true,
    "EnableTagsOrderDocumentFilter": true,
    "ServerDir": null,
    //登录访问Swagger
    "LoginInfo": {
      "Enabled": true,
      //可以写任何自定义检查地址
      "CheckUrl": "/api/swaggerlogin/checkurl",
      //可以写任何自定义检查地址
      "SubmitUrl": "/api/swaggerlogin/url",
      //生产环境可用
      "EnableOnProduction": true,
      //登录用户
      "DefaultUsername": "admin",
      "DefaultPassword": "cyc666"
    }
  },
  //7:Jwt设置项
  "JWTSettings": {
    //是否验证签发方密钥，bool 类型，默认true
    "ValidateIssuerSigningKey": true,
    //签发方密钥（公钥），string 类型，必须是复杂密钥，长度大于16
    "IssuerSigningKey": "W2S0C0Y0Y5QAZWSXEDC7568GYL1019ABCDEF",
    //签发方密钥（私钥），RS*/PS*/ES* 加密算法使用
    "IssuerSigningPrivateKey ": "",
    //是否验证签发方，bool 类型，默认true
    "ValidateIssuer": true,
    //签发方，string 类型
    "ValidIssuer": "D9D4A4770F",
    //是否验证签收方，bool 类型，默认true
    "ValidateAudience": true,
    //签收方，string 类型
    "ValidAudience": "D9D4A4770F",
    //是否验证过期时间，bool 类型，默认true，建议true
    "ValidateLifetime": true,
    //必须配置过期时间
    "RequireExpirationTime": true,
    //过期时间，long 类型，单位分钟，默认20分钟
    "ExpiredTime": 1450,
    //一天
    //过期时间容错值，long 类型，单位秒，默认 5秒
    "ClockSkew": 5,
    //加密算法，string 类型，默认 HS256
    "Algorithm": "HS256",
    //配置获取 Token 的报文头可选值
    "TokenHeaders": []
  },
  //8:异常处理配置
  "FriendlyExceptionSettings": {
    //隐藏错误码，bool 类型，默认 false
    "HideErrorCode": false,
    //默认错误码，string 类型
    "DefaultErrorCode": "400",
    //默认错误消息，string 类型
    "DefaultErrorMessage": "系统异常，请联系管理员",
    //是否将 Oops.Oh 默认抛出为业务异常，bool 类型，默认 false，设置 true 之后 Oops.Oh 默认进入
    "ThrowBah": true,
    //是否输出异常日志，bool 类型，默认 true
    "LogError": true
  }
}